<Window x:Class="AirWave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AirWave"
        Title="AirWave" Width="440" Height="720" MinWidth="380" MinHeight="540"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/AirWave.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BoolToVisibility x:Key="Vis"/>
        <local:BoolToVisibility x:Key="InvVis" Invert="True"/>
        <local:BoolToVisibility x:Key="NotVis" Invert="True"/>
        <local:LevelToWidth x:Key="LevelScale"/>

        <!-- A speaker card -->
        <DataTemplate x:Key="SpeakerTemplate" DataType="{x:Type local:SpeakerViewModel}">
            <Border x:Name="Card" Style="{StaticResource Card}" Margin="16,0,16,10" Padding="14,12">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove this speaker" Click="RemoveSpeaker_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBg" Width="42" Height="42" CornerRadius="21" Background="{StaticResource Surface2Brush}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="IconGlyph" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource MutedBrush}"/>
                            <!-- connecting ring -->
                            <Ellipse x:Name="Ring" Width="42" Height="42" StrokeThickness="2" Stroke="{StaticResource AccentBrush}"
                                     StrokeDashArray="12 30" Visibility="{Binding IsConnecting, Converter={StaticResource Vis}}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="RingSpin"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="RingSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,2,0,0" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center"
                              ToolTip="Play on this speaker"/>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="{Binding ShowVolume, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" Margin="12,0,6,0"
                                SmallChange="0.02" LargeChange="0.1"/>
                        <TextBlock Grid.Column="2" Text="{Binding VolumePercent}" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <ToggleButton x:Name="TimingToggle" Grid.Column="3" Style="{StaticResource IconToggle}" Content="&#xE916;" Margin="6,0,0,0"
                                      IsChecked="{Binding ShowTiming, Mode=TwoWay}" ToolTip="Timing: line this speaker up with the others"/>
                    </Grid>

                    <!-- Timing nudge -->
                    <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="12,10" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                            Visibility="{Binding ShowTiming, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Timing" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OffsetText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Earlier" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="-500" Maximum="500" Value="{Binding OffsetMs, Mode=TwoWay, Delay=250}" Margin="10,0"
                                        SmallChange="5" LargeChange="25" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                <TextBlock Grid.Column="2" Text="Later" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,70,0"
                                           Text="If this speaker sounds ahead of the others, move it later; if behind, earlier. Arrow keys move 5 ms."/>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4"
                                        Click="ResetTiming_Click" Visibility="{Binding HasOffset, Converter={StaticResource Vis}}">
                                    <TextBlock Text="Reset" FontSize="12.5"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="IconBg" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="#2A5C5E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                    <Setter TargetName="StatusText" Property="TextTrimming" Value="None"/>
                    <Setter TargetName="StatusText" Property="MaxHeight" Value="200"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ScreenTemplate" DataType="{x:Type local:ScreenViewModel}">
            <Border x:Name="Card" Style="{StaticResource Card}" Margin="16,0,16,10" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBg" Width="44" Height="44" CornerRadius="22" Background="{StaticResource Surface2Brush}" VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyph" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" ToolTip="{Binding Details}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="MirrorButton" Grid.Column="2" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Padding="14,7"
                            Content="{Binding ButtonText}" Click="MirrorButton_Click" MinWidth="76"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMirroring}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="IconBg" Property="Background" Value="#1A2DD4BF"/>
                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="MirrorButton" Property="Style" Value="{StaticResource BaseButton}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="MirrorButton" Property="Style" Value="{StaticResource BaseButton}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ===================== Main page ===================== -->
        <Grid x:Name="MainPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/AirWave-256.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="AirWave" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="10" ToolTip="Minimise" Click="Minimise_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- Hero: what's being sent -->
            <Border Grid.Row="1" Margin="16,4,16,16" CornerRadius="16" Background="{StaticResource HeroGradient}"
                    BorderBrush="#21304A" BorderThickness="1" Padding="18,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Your PC's sound" Style="{StaticResource Title}"/>
                            <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12.5"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource BaseButton}" VerticalAlignment="Top" Click="StopAll_Click"
                                Visibility="{Binding IsStreaming, Converter={StaticResource Vis}}" Background="#2A1B24" Foreground="#FCA5A5" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="11"/>
                                <TextBlock Text="Stop" Margin="7,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- level meter -->
                    <Grid Margin="0,16,0,14" Height="6">
                        <Border CornerRadius="3" Background="#22FFFFFF"/>
                        <Border CornerRadius="3" Background="{StaticResource AccentGradient}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Level, Converter={StaticResource LevelScale}, ConverterParameter=1}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <TextBlock Text="Sound from" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" DropDownOpened="Devices_DropDownOpened"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2">
            <!-- A newer version is out -->
            <Border x:Name="UpdateBanner" Margin="16,-6,16,16" CornerRadius="14" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="14,12"
                    Visibility="{Binding ShowUpdateBanner, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#1A2DD4BF" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UpdateSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <Grid Height="4" Margin="0,6,0,0" Visibility="{Binding UpdateBusy, Converter={StaticResource Vis}}">
                            <Border CornerRadius="2" Background="#22FFFFFF"/>
                            <Border CornerRadius="2" Background="{StaticResource AccentGradient}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding UpdateProgress}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock Margin="0,4,0,0" FontSize="12.5" Visibility="{Binding UpdateNotBusy, Converter={StaticResource Vis}}">
                            <Hyperlink Click="WhatsNew_Click" Foreground="{StaticResource AccentBrush}">What's new</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Padding="14,7" Content="Update" Click="Update_Click"
                                Visibility="{Binding UpdateNotBusy, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="4,0,0,0" Click="UpdateLater_Click"
                                Visibility="{Binding UpdateNotBusy, Converter={StaticResource Vis}}">
                            <TextBlock Text="Later" FontSize="12.5"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="10,6" Click="UpdateCancel_Click"
                                Visibility="{Binding UpdateBusy, Converter={StaticResource Vis}}">
                            <TextBlock Text="Cancel" FontSize="12.5"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- AirPlay coming in from a phone/Mac: what's playing, with controls -->
            <Border x:Name="NowPlayingCard" Margin="16,-6,16,16" CornerRadius="14" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="14,12"
                    Visibility="{Binding ReceiverActive, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Artwork, or the phone icon when there isn't any -->
                    <Grid VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#1A2DD4BF" Visibility="{Binding NpNoArtwork, Converter={StaticResource Vis}}">
                            <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <Border Width="56" Height="56" CornerRadius="8" Visibility="{Binding NpHasArtwork, Converter={StaticResource Vis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding NpArtwork}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ReceiverTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding NpArtist}" Margin="0,1,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding NpHasArtist, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding ReceiverSubtitle}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" VerticalAlignment="Top" ToolTip="Stop the iPhone or Mac playing to this PC"
                            Click="DisconnectReceiver_Click" Padding="10,6">
                        <TextBlock Text="Disconnect" FontSize="12.5"/>
                    </Button>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <!-- Track position when known, otherwise the sound level -->
                            <Grid Height="4">
                                <Border CornerRadius="2" Background="#22FFFFFF"/>
                                <Border CornerRadius="2" Background="{StaticResource AccentGradient}" RenderTransformOrigin="0,0.5"
                                        Visibility="{Binding NpHasDuration, Converter={StaticResource Vis}}">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding NpProgress}"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Border CornerRadius="2" Background="{StaticResource AccentGradient}" RenderTransformOrigin="0,0.5"
                                        Visibility="{Binding NpHasDuration, Converter={StaticResource InvVis}}">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ReceiverLevel, Converter={StaticResource LevelScale}, ConverterParameter=1}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding NpTimes}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"
                                       Visibility="{Binding NpHasDuration, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasRemote, Converter={StaticResource Vis}}">
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous" Click="RemotePrevious_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="{Binding PlayPauseGlyph}" ToolTip="{Binding PlayPauseTip}" FontSize="16" Click="RemotePlayPause_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next" Click="RemoteNext_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            </StackPanel>

            <!-- Speakers header -->
            <Grid Grid.Row="3" Margin="20,0,12,8">
                <TextBlock Text="SPEAKERS" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add a speaker by its IP address" Click="AddByIp_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Look for speakers again" Click="Rescan_Click"/>
                </StackPanel>
            </Grid>

            <!-- Speaker list -->
            <ScrollViewer x:Name="SpeakerScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Speakers}" ItemTemplate="{StaticResource SpeakerTemplate}" Margin="0,0,0,6"/>
                    <StackPanel Visibility="{Binding HasScreens, Converter={StaticResource Vis}}">
                        <TextBlock Text="MIRROR YOUR SCREEN" Style="{StaticResource Section}" Margin="20,10,0,10"/>
                        <ItemsControl ItemsSource="{Binding Screens}" ItemTemplate="{StaticResource ScreenTemplate}" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,40"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                    <Ellipse Stroke="{StaticResource Surface3Brush}" StrokeThickness="3"/>
                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeDashArray="8 40" RenderTransformOrigin="0.5,0.5"
                             Visibility="{Binding Searching, Converter={StaticResource Vis}}">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="EmptySpin"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="EmptySpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="&#xE7F5;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
                <TextBlock Text="Looking for AirPlay speakers" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" FontSize="12.5"
                           Text="Make sure your HomePods or Sonos speakers are switched on and connected to the same network as this PC."/>
            </StackPanel>

            <!-- Master volume -->
            <Border Grid.Row="5" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SurfaceBrush}" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE995;" Style="{StaticResource Icon}" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="All speakers" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Margin="16,0,8,0" Minimum="0" Maximum="1" SmallChange="0.02" LargeChange="0.1"
                            Value="{Binding MasterVolume, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="2" Text="{Binding MasterPercent}" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Add by IP ===================== -->
        <Grid x:Name="AddPanel" Background="#B3070A10" Visibility="Collapsed" MouseDown="AddPanelBackdrop_MouseDown">
            <Border Style="{StaticResource Card}" Background="{StaticResource Surface2Brush}" Margin="24" VerticalAlignment="Center" Padding="20" MouseDown="StopBubble">
                <StackPanel>
                    <TextBlock Text="Add a speaker" Style="{StaticResource Title}" FontSize="17"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,14"
                               Text="If a speaker doesn't show up by itself (for example it's on a different network segment), enter its IP address. You can find it in your router or the speaker's app."/>
                    <TextBlock Text="IP address" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                    <TextBox x:Name="AddIp" Text="192.168."/>
                    <TextBlock Text="Name (optional)" Style="{StaticResource Section}" Margin="0,12,0,6"/>
                    <TextBox x:Name="AddName"/>
                    <TextBlock x:Name="AddError" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"
                               Text="That doesn't look like an IP address (it should be like 192.168.1.40)."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource BaseButton}" Content="Cancel" Click="AddCancel_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="Add speaker" Click="AddConfirm_Click" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== TV code / password ===================== -->
        <Grid x:Name="PromptPanel" Background="#B3070A10" Visibility="{Binding PromptVisible, Converter={StaticResource Vis}}" IsVisibleChanged="PromptPanel_IsVisibleChanged">
            <Border Style="{StaticResource Card}" Background="{StaticResource Surface2Brush}" Margin="24" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding PromptTitle}" Style="{StaticResource Title}" FontSize="17" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PromptMessage}" Style="{StaticResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                    <TextBox x:Name="PromptText" FontSize="22" HorizontalContentAlignment="Center" MaxLength="16"
                             Visibility="{Binding PromptIsPassword, Converter={StaticResource InvVis}}" KeyDown="Prompt_KeyDown"/>
                    <PasswordBox x:Name="PromptPassword" FontSize="15" Visibility="{Binding PromptIsPassword, Converter={StaticResource Vis}}" KeyDown="Prompt_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource BaseButton}" Content="Cancel" Click="PromptCancel_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="Continue" Click="PromptOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Settings ===================== -->
        <Grid x:Name="SettingsPage" Background="{StaticResource BgBrush}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back" Click="SettingsBack_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="10" ToolTip="Minimise" Click="Minimise_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,4,16,20">

                    <TextBlock Text="SOUND" Style="{StaticResource Section}" Margin="4,8,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MutePcWhileStreaming, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Mute this PC while streaming" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Stops the sound coming out of the PC as well as the speakers. Your PC's volume comes back when you stop."/>
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <Grid>
                                <TextBlock Text="Delay" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DelayText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="3" SmallChange="0.1" LargeChange="0.5" Margin="0,10,0,6" Value="{Binding DelaySeconds, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="0.1"/>
                            <TextBlock Style="{StaticResource Muted}" Text="How far ahead the sound is sent. AirPlay speakers always play a little behind the PC; a longer delay copes better with weak Wi-Fi, a shorter one feels more responsive. 2.0 s is what Apple devices use."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="AIRPLAY TO THIS PC" Style="{StaticResource Section}" Margin="4,18,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ReceiverEnabled, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Let iPhones, iPads and Macs play to this PC" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="{Binding ReceiverHint}"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel IsEnabled="{Binding ReceiverEnabled}">
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                                <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="ReceiverNameBox" Text="{Binding ReceiverName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="ReceiverName_KeyDown"/>
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                                <TextBlock Text="Play it on" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox SelectedIndex="{Binding ReceiverOutputIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="This PC's speakers or headphones"/>
                                    <ComboBoxItem Content="My AirPlay speakers (the ones switched on)"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Passing it on to AirPlay speakers adds a short extra delay, so it won't line up with video on the phone."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SCREEN MIRRORING" Style="{StaticResource Section}" Margin="4,18,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MirrorWithSound, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Send the PC's sound with the picture" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Plays through the TV, in time with the picture."/>
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <TextBlock Text="Picture delay" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox SelectedIndex="{Binding MirrorDelayIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Lowest (about 0.1 s) – best for using the PC on the TV"/>
                                <ComboBoxItem Content="Balanced (about 0.2 s)"/>
                                <ComboBoxItem Content="Smoothest (about 0.4 s) – best for weak Wi-Fi and video"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="How far behind the PC the TV shows the picture. If it stutters or skips, choose a longer delay. Applies next time you mirror."/>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <CheckBox x:Name="GpuEncoderSwitch" Style="{StaticResource Switch}" IsChecked="{Binding UseGpuEncoder, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Use the graphics card encoder" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Full resolution at 60 fps, with little load on the PC. Turn off if the picture has problems; the standard encoder sends up to 1080p at 30 fps. Applies next time you mirror."/>
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BaseButton}" Content="Forget paired TVs" Click="ForgetTvs_Click"/>
                                <TextBlock x:Name="ForgetDone" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Text="Done – TVs will ask for a code again."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="APP" Style="{StaticResource Section}" Margin="4,18,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ReconnectOnLaunch, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Reconnect my speakers when AirWave opens" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Picks up where you left off."/>
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}">
                                <TextBlock Text="Start with Windows (in the notification area)" FontWeight="SemiBold"/>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Keep running when the window is closed" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="AirWave stays in the notification area by the clock so the music keeps playing."/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="UPDATES" Style="{StaticResource Section}" Margin="4,18,0,8"/>
                    <Border x:Name="UpdatesCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Check for updates automatically" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Lets you know when there's a new version. Nothing is installed until you press Update."/>
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding UpdateCheckText}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource AccentButton}" Content="Update now" Padding="14,7" Margin="0,0,8,0" Click="Update_Click"
                                            Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}" IsEnabled="{Binding UpdateNotBusy}"/>
                                    <Button Style="{StaticResource BaseButton}" Content="Check now" Click="CheckUpdates_Click" IsEnabled="{Binding NotChecking}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource Section}" Margin="4,18,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DetailedLogging, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Detailed diagnostics" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Records everything speakers, TVs and phones say to AirWave. Turn on, try again, then Copy diagnostics."/>
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ForceNtp, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Use older timing (NTP) for every speaker" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Only if a speaker connects but stays silent. Newer Sonos speakers need this off."/>
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BaseButton}" Content="Copy diagnostics" Click="CopyLog_Click" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource BaseButton}" Content="Test a speaker" Click="OpenLab_Click" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource BaseButton}" Content="Open settings folder" Click="OpenFolder_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="CopyDone" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed" Text="Copied – paste it into a GitHub issue if you need help."/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="4,20,0,0">
                        <Image Source="Assets/AirWave-256.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"><Run Text="AirWave "/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
                            <TextBlock Style="{StaticResource Muted}" Text="Play your PC's sound on AirPlay 2 speakers, in sync."/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===================== Speaker test ===================== -->
        <Grid x:Name="LabPanel" Background="{StaticResource BgBrush}" Visibility="{Binding LabVisible, Converter={StaticResource Vis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,20">
                    <TextBlock Text="Test a speaker" Style="{StaticResource Title}" FontSize="18"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap"
                               Text="Plays beeps to one speaker in each of the ways AirWave can send audio, about 10 seconds each. Test 1 beeps once at a time, test 2 twice, and so on. Note which numbers you hear. Other speakers are switched off while it runs."/>
                    <TextBlock Text="Speaker" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="LabSpeakerBox" ItemsSource="{Binding Speakers}" SelectedItem="{Binding LabSpeaker, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{Binding LabNotRunning}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="LabStartButton" Style="{StaticResource AccentButton}" Content="Start test" Padding="16,8" Click="LabStart_Click" IsEnabled="{Binding LabNotRunning}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource BaseButton}" Content="Stop" Click="LabStop_Click" IsEnabled="{Binding LabRunning}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource BaseButton}" Content="Close" Click="LabClose_Click" IsEnabled="{Binding LabNotRunning}"/>
                    </StackPanel>
                    <TextBlock x:Name="LabStatusText" Text="{Binding LabStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,10" TextWrapping="Wrap"/>
                    <TextBox x:Name="LabResultsBox" Text="{Binding LabResults, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" MinHeight="160"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
